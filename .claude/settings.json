{
  "$comment": "Team-wide Claude Code config. (1) Read guards: Claude does NOT read .aiexclude/.copilotignore, so the big-file protections live here. 'deny' = never read (Crowdin-managed translations, one entry per language: values-fr is managed by the fork, so it is not listed, and a language added later must be added here); 'ask' = prompt first (big files rarely needed in full — prefer .skills/compose-ui/strings-index.txt for strings; signing keys should never be read into context). (2) Hooks front-run this repo's own CI gates locally — see .claude/hooks/*.sh for what each does. The pre-bash-guard spotlessApply-on-commit hook is the heaviest (runs gradle at commit time); remove its PreToolUse entry if it's too eager for your workflow.",
  "permissions": {
    "deny": [
      "Read(**/composeResources/**/values-ar/*.xml)",
      "Read(**/composeResources/**/values-be/*.xml)",
      "Read(**/composeResources/**/values-bg/*.xml)",
      "Read(**/composeResources/**/values-ca/*.xml)",
      "Read(**/composeResources/**/values-cs/*.xml)",
      "Read(**/composeResources/**/values-de/*.xml)",
      "Read(**/composeResources/**/values-el/*.xml)",
      "Read(**/composeResources/**/values-es/*.xml)",
      "Read(**/composeResources/**/values-et/*.xml)",
      "Read(**/composeResources/**/values-fi/*.xml)",
      "Read(**/composeResources/**/values-ga/*.xml)",
      "Read(**/composeResources/**/values-gl/*.xml)",
      "Read(**/composeResources/**/values-he/*.xml)",
      "Read(**/composeResources/**/values-hr/*.xml)",
      "Read(**/composeResources/**/values-ht/*.xml)",
      "Read(**/composeResources/**/values-hu/*.xml)",
      "Read(**/composeResources/**/values-is/*.xml)",
      "Read(**/composeResources/**/values-it/*.xml)",
      "Read(**/composeResources/**/values-ja/*.xml)",
      "Read(**/composeResources/**/values-ko/*.xml)",
      "Read(**/composeResources/**/values-lt/*.xml)",
      "Read(**/composeResources/**/values-nl/*.xml)",
      "Read(**/composeResources/**/values-no/*.xml)",
      "Read(**/composeResources/**/values-pl/*.xml)",
      "Read(**/composeResources/**/values-pt/*.xml)",
      "Read(**/composeResources/**/values-pt-rBR/*.xml)",
      "Read(**/composeResources/**/values-ro/*.xml)",
      "Read(**/composeResources/**/values-ru/*.xml)",
      "Read(**/composeResources/**/values-sk/*.xml)",
      "Read(**/composeResources/**/values-sl/*.xml)",
      "Read(**/composeResources/**/values-sq/*.xml)",
      "Read(**/composeResources/**/values-sr/*.xml)",
      "Read(**/composeResources/**/values-srp/*.xml)",
      "Read(**/composeResources/**/values-sv/*.xml)",
      "Read(**/composeResources/**/values-tr/*.xml)",
      "Read(**/composeResources/**/values-uk/*.xml)",
      "Read(**/composeResources/**/values-zh-rCN/*.xml)",
      "Read(**/composeResources/**/values-zh-rTW/*.xml)"
    ],
    "ask": [
      "Read(**/composeResources/**/values/strings.xml)",
      "Read(**/firmware_releases.json)",
      "Read(**/composeResources/files/emoji-data.json)",
      "Read(**/flatpak-sources*.json)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Post-edit checks (strings sort / metadata length / module CI filter / Compose pitfalls)"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-audit.sh\"",
            "timeout": 15,
            "statusMessage": "Subagent-audit (did the subagent touch the tree?)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-guard.sh\"",
            "timeout": 300,
            "statusMessage": "Pre-commit spotlessApply on staged Kotlin / destructive-git confirm"
          }
        ]
      }
    ]
  }
}
